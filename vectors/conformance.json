{
  "protocol": "at",
  "version": "1",
  "notes": "Plain text must be the entire body (one trailing newline allowed). JSON name may omit @. Length is 1 to 15 characters: [a-z0-9_], one Extended_Pictographic scalar, or a flag pair counted as one character. A lone regional indicator, a ZWJ sequence, or a skin tone is not a handle. A dot, a DNS marker, or a DX marker never registers a handle.",
  "vectors": [
    {
      "id": "plain-jon",
      "ok": true,
      "op": "register",
      "body": "@jon",
      "handle": "@jon"
    },
    {
      "id": "plain-trailing-newline",
      "ok": true,
      "op": "register",
      "body": "@jon\n",
      "handle": "@jon"
    },
    {
      "id": "plain-case-fold",
      "ok": true,
      "op": "register",
      "body": "@Jon",
      "handle": "@jon"
    },
    {
      "id": "plain-fullwidth",
      "ok": true,
      "op": "register",
      "body": "＠ｊｏｎ",
      "handle": "@jon"
    },
    {
      "id": "plain-underscore",
      "ok": true,
      "op": "register",
      "body": "@_jon",
      "handle": "@_jon"
    },
    {
      "id": "plain-len-15",
      "ok": true,
      "op": "register",
      "body": "@abcdefghijklmno",
      "handle": "@abcdefghijklmno"
    },
    {
      "id": "json-register-with-at",
      "ok": true,
