      "handle": "@jon",
      "content": "hi"
    },
    {
      "id": "json-update-alias",
      "ok": true,
      "op": "config",
      "body": "{\"p\":\"at\",\"op\":\"upd\",\"name\":\"jon\",\"url\":\"https://dogecoin.dog\"}",
